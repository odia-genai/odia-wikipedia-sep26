# the corpus: `prepare.py build` makes it from what is tracked
/orwiki-*.jsonl
# optional per-article Markdown export (`build --markdown`): a second copy of the corpus
/markdown/
# the dump `prepare.py download` fetches; its article index is tracked
/raw/*.xml.bz2
# the revision-history dump `annotate.py download` fetches
/raw/*.xml.gz
# temporary and partial files
*.tmp
*.part
*.bad
__pycache__/
.cache/
# translation work batches: scratch between `translate.py batches` and `merge`
translations/work/

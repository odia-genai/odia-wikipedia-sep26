    "extreme_share": "share of the article's scored bytes that are in extreme paragraphs",
    "review_rank": "order to review in, 1 = first; the top 200 articles, failure types interleaved; null = not flagged",
    "review_type": "primary failure type: garbled, english, templated, table, markup, script, article",
